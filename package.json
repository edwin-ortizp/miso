{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build && node scripts/publish-vite-css.mjs",
        "dev": "vite",
        "test:js": "node --test tests/JavaScript/pomodoro-timer.test.js tests/JavaScript/energy-pricing.test.js tests/JavaScript/dialog-viewport.test.js",
        "test:browser": "playwright test --project=interaction",
        "test:a11y": "playwright test --project=accessibility",
        "test:responsive": "playwright test --project=responsive",
        "test:visual": "playwright test --project=visual",
        "test:visual:update": "playwright test --project=visual --update-snapshots=all"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.12.1",
        "@playwright/test": "^1.62.1",
        "@tailwindcss/vite": "^4.0.0",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^3.1",
        "tailwindcss": "^4.0.0",
        "vite": "^8.0.0"
    },
    "dependencies": {
        "@fontsource/instrument-sans": "^5.3.0",
        "@fullcalendar/core": "^6.1.22",
        "@fullcalendar/daygrid": "^6.1.22",
        "@fullcalendar/interaction": "^6.1.22",
        "@fullcalendar/list": "^6.1.22",
        "@fullcalendar/timegrid": "^6.1.22",
        "apexcharts": "^5.16.0",
        "bootstrap": "^5.3.3",
        "bootstrap-icons": "^1.11.3"
    }
}
