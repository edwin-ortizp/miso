{% from '@project/components/life-shell.html.jinja' import dialog %}
{% from '@project/components/learning-companion.html.jinja' import learning_companion, team_art %}
{% from '@project/components/life-shell.html.jinja' import shell, tabs as module_tabs, metric, manage_card, row_split, applied_filters, date_filters %}
{% call shell('pomodoro', 'Pomodoro', 'bi-stopwatch') %}
{{ learning_companion(true) }}
{{ module_tabs([('Temporizador','/pomodoro-timer','bi-stopwatch'),('Ajustes','/pomodoro-settings','bi-sliders')], '/pomodoro-timer') }}
<section class="lt-metrics" aria-label="Resumen de enfoque">{{ metric('Enfoque hoy','1 h 40 min','success') }}{{ metric('Sesiones','4 de 8') }}{{ metric('Racha','6 días','warning') }}</section>
<section class="lt-grid-main">
  <div class="lt-stack">
    <article class="lt-panel lt-panel--accent"><div class="lt-panel__body">
      <div class="lt-timer">
        <div class="lt-segmented" role="group" aria-label="Modo del temporizador"><button class="is-active" type="button" data-lt-static-nav>Enfoque</button><button type="button" data-lt-static-nav>Pausa corta</button><button type="button" data-lt-static-nav>Pausa larga</button></div>
        <div class="lt-timer__ring" style="--value:25" role="img" aria-label="Quedan 18 minutos y 42 segundos de 25"><div class="lt-timer__face"><strong>18:42</strong><span>Sesión 5 de 8</span></div></div>
        <label class="lt-field"><span>¿En qué trabajas?</span><input type="text" value="Revisar presupuesto trimestral"></label>
        <div class="lt-timer__controls"><button class="lt-icon-button" type="button" data-lt-static-nav aria-label="Reiniciar el temporizador"><i class="bi bi-arrow-counterclockwise"></i></button><button class="lt-button lt-button--xl" type="button" data-lt-static-nav><i class="bi bi-pause-fill"></i> Pausar</button><button class="lt-icon-button" type="button" data-lt-static-nav aria-label="Saltar a la pausa"><i class="bi bi-skip-forward-fill"></i></button></div>
      </div>
    </div></article>
    {% call(zone) manage_card('pomodoro-sessions', 'Sesiones del día', 'bi-list-check', count='(4 / 215)', total=215, search='Buscar sesiones', filters=1, menu=[('Exportar CSV', 'bi-filetype-csv')], footer={'from':1,'to':4,'total':4,'noun':'sesiones','page':1,'pages':1,'per_page':25}, footer_all={'to':25,'total':215,'pages':9}) %}{% if zone == 'filters' %}
      {% call date_filters('pomodoro-sessions') %}<label class="lt-field"><span>Origen</span><select><option>Todos</option><option>Temporizador</option><option>Registro manual</option></select></label>{% endcall %}
    {% else %}
      {{ applied_filters([('bi-calendar-event','Fecha: Hoy')]) }}
      <table class="lt-mtable">
        <thead><tr><th scope="col">Fecha</th><th scope="col">Tarea</th><th scope="col">Horario</th><th scope="col">Duración</th><th scope="col">Origen</th><th scope="col" class="lt-mtable__actions">Acciones</th></tr></thead>
        <tbody>
        {% for date, task, start, end, dur, manual, old in [('Hoy','Reunión de planeación','14:00','14:25','25 min',true,false),('Hoy','Correos y seguimiento','10:10','10:35','25 min',false,false),('Hoy','Preparar propuesta','08:30','08:55','25 min',false,false),('Hoy','Preparar propuesta','08:00','08:25','25 min',false,false),('9 sep.','Lectura técnica','16:00','16:45','45 min',true,true),('9 sep.','Informe mensual','08:30','08:55','25 min',false,true),('9 sep.','Informe mensual','08:00','08:25','25 min',false,true)] %}
          <tr{% if old %} data-lt-outside-filter{% endif %}>
            <td class="lt-mtable__date" data-label="Fecha">{{ date }}</td>
            <td class="lt-mtable__title" data-label="Tarea">{{ task }}</td>
            <td class="lt-mtable__time" data-label="Horario">{{ start }} – {{ end }}</td>
            <td data-label="Duración">{{ dur }}</td>
            <td data-label="Origen"><span class="lt-chip">{{ 'Manual' if manual else 'Temporizador' }}</span></td>
            <td class="lt-mtable__actions">{{ row_split('pomodoro-session-menu-' ~ loop.index, 'Editar', [('Eliminar','bi-trash',true)], 'la sesión ' ~ task ~ ' de ' ~ date ~ ' ' ~ start) }}</td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
    {% endif %}{% endcall %}
  </div>
  <aside class="lt-stack">
    <article class="lt-panel"><div class="lt-panel__head"><i class="bi bi-bullseye"></i><h3>Meta diaria</h3><small>4 de 8</small></div><div class="lt-panel__body">
      <div class="lt-progress" aria-label="Avance de la meta diaria"><span style="width:50%"></span></div>
      <p class="lt-page-head__subtitle">Faltan 4 sesiones (1 h 40 min) para cumplir la meta.</p>
    </div></article>
    <article class="lt-panel"><div class="lt-panel__head"><i class="bi bi-calendar-week"></i><h3>Esta semana</h3><small>6 h 15 min</small></div><div class="lt-panel__body">
      <div class="lt-bars" aria-label="Enfoque de la semana">{% for d, v in [('L',100),('M',75),('X',50),('J',0),('V',0),('S',0),('D',0)] %}<div class="lt-bars__col"><div class="lt-bars__track"><span class="lt-bars__fill" style="--value:{{ v }}%"></span></div><span>{{ d }}</span></div>{% endfor %}</div>
      <dl class="lt-dl"><div><dt>Enfoque del mes</dt><dd>21 h 30 min</dd></div><div><dt>Mejor día</dt><dd>Lunes · 8 sesiones</dd></div></dl>
    </div></article>
    <article class="lt-panel"><div class="lt-panel__head"><i class="bi bi-plus-circle"></i><h3>Registrar tiempo manual</h3></div><div class="lt-panel__body">
      <div class="lt-form">
        <label class="lt-field"><span>Inicio</span><input type="time" value="16:00"></label>
        <label class="lt-field"><span>Fin</span><input type="time" value="16:45"></label>
        <label class="lt-field lt-form--full"><span>Descripción (opcional)</span><input type="text" placeholder="Ej. lectura técnica"></label>
      </div>
      <div class="lt-actions"><button class="lt-button lt-button--tonal" type="button" data-lt-static-nav>Registrar</button></div>
    </div></article>
  </aside>
</section>
{% call dialog('guardian-sheet','Abra · Nv 12',close_only=true) %}<div class="lt-learning-sheet">{{ team_art() }}<p>Equipo de la semana · Concentración</p><p>Compañero ficticio para revisar la experiencia.</p></div>{% endcall %}
{% endcall %}
