{% from '@project/components/life-shell.html.jinja' import dialog %}
{% from '@project/components/learning-companion.html.jinja' import learning_companion, team_art %}
{% from '@project/components/life-shell.html.jinja' import shell, tabs as module_tabs, header, metric, dialog, fab, manage_card, row_split %}
{% call shell('goals', 'Objetivos', 'bi-flag') %}
{{ learning_companion(false) }}
{{ header('Objetivos', 'Resultados activos y próximos pasos.', 'bi-flag') }}
{{ module_tabs([('Objetivos','/goals-index','bi-flag'),('Detalle','/goals-detail','bi-bullseye')], '/goals-index') }}
<section class="lt-metrics">{{ metric('Objetivos activos','5') }}{{ metric('Hitos este mes','9','success') }}{{ metric('Avance promedio','64 %') }}</section>
<section class="lt-grid-main">{% call(zone) manage_card('goals', 'Objetivos activos', 'bi-flag', count='(3 / 5)', total=5, search='Buscar objetivos', menu=[('Exportar CSV', 'bi-filetype-csv')], footer={'from':1,'to':3,'total':5,'noun':'objetivos','page':1,'pages':1,'per_page':25}, sort=[('recent','Más recientes','bi-clock-history'),('due','Fecha límite próxima','bi-calendar-event'),('title','Título (A–Z)','bi-sort-alpha-down')]) %}{% if zone == 'filters' %}
      <div class="lt-popover" id="goals-filters" role="dialog" aria-labelledby="goals-filters-title" hidden><span class="lt-popover__handle" aria-hidden="true"></span>
        <div class="lt-popover__head"><h4 id="goals-filters-title">Filtros</h4><button class="lt-icon-button" type="button" data-lt-toggle="goals-filters" aria-label="Cerrar filtros"><i class="bi bi-x-lg"></i></button></div>
        <div class="lt-field"><span>Estado</span><div class="lt-chip-row"><button class="lt-chip lt-chip--filter is-selected" type="button" data-lt-static-nav aria-pressed="true">Activos</button><button class="lt-chip lt-chip--filter" type="button" data-lt-static-nav>Completados</button><button class="lt-chip lt-chip--filter" type="button" data-lt-static-nav>Pausados</button></div></div>
        <label class="lt-field"><span>Fecha límite</span><select><option>Cualquiera</option><option>Este mes</option><option>Este trimestre</option><option>Este año</option></select></label>
        <div class="lt-popover__actions"><button class="lt-button lt-button--outlined" type="button" data-lt-static-nav><i class="bi bi-eraser" aria-hidden="true"></i>Limpiar</button><button class="lt-button" type="button" data-lt-toggle="goals-filters"><i class="bi bi-funnel-fill" aria-hidden="true"></i>Filtrar</button></div>
      </div>
    {% else %}
<div class="lt-list">{% for goal, progress in [('Correr 10K',68),('Certificación profesional',54),('Fondo de emergencia',72)] %}<div class="lt-list-item"><div class="lt-list-item__body"><strong>{{ goal }}</strong><div class="lt-progress"><span style="width:{{ progress }}%"></span></div></div><span class="lt-chip">{{ progress }} %</span>{{ row_split('goal-menu-' ~ loop.index, 'Editar', [('Completar','bi-check-circle',false),('Abandonar','bi-x-circle',false),('Eliminar','bi-trash',true)], goal, dialog='goal-new') }}</div>{% endfor %}</div>{% endif %}{% endcall %}<article class="lt-panel"><div class="lt-panel__head"><i class="bi bi-stars"></i><h3>Próximo hito</h3></div><div class="lt-panel__body"><strong>Completar 8 km sin pausa</strong><p class="lt-page-head__subtitle">Faltan dos entrenamientos para el siguiente avance.</p><div class="lt-route-links"><a class="lt-button" href="#/goals-detail">Ver detalle</a></div></div></article></section>
{{ fab('Agregar objetivo', 'bi-flag', 'goal-new') }}
{% call dialog('goal-new', 'Agregar objetivo', icon='bi-flag', sections=[('basic','Información básica','bi-flag'),('kpi','Indicador (KPI)','bi-graph-up-arrow')]) %}
<section class="lt-dialog__section" data-section="basic">
  <header class="lt-dialog__section-head"><h3>Información básica</h3></header>
  <div class="lt-form"><label class="lt-field lt-form--full"><span>Título *</span><input type="text" placeholder="Ej. Correr 10K"></label><label class="lt-field lt-form--full"><span>Descripción</span><textarea></textarea></label><label class="lt-field "><span>Fecha inicio</span><input type="date"></label><label class="lt-field "><span>Fecha límite</span><input type="date"></label></div>
</section>
<section class="lt-dialog__section" data-section="kpi" hidden>
  <header class="lt-dialog__section-head"><h3>Indicador (KPI)</h3></header>
  <div class="lt-form"><label class="lt-field "><span>Nombre del KPI</span><input type="text" placeholder="Kilómetros"></label><label class="lt-field "><span>Unidad</span><input type="text" placeholder="km"></label><label class="lt-field "><span>Valor inicial</span><input type="number" value="0"></label><label class="lt-field "><span>Valor objetivo</span><input type="number" value="10"></label></div>
</section>
{% endcall %}
{% call dialog('guardian-sheet','Abra · Nv 12',close_only=true) %}<div class="lt-learning-sheet">{{ team_art() }}<p>Equipo de la semana · Concentración</p><p>Compañero ficticio para revisar la experiencia.</p></div>{% endcall %}
{% endcall %}
