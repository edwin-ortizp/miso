{% from '@project/components/life-shell.html.jinja' import dialog %}
{% from '@project/components/learning-companion.html.jinja' import learning_companion, team_art %}
{% from '@project/components/life-shell.html.jinja' import shell, tabs as module_tabs, header, metric, manage_card, fab %}
{% call shell('tasks', 'Lista de tareas', 'bi-list-task') %}
{{ learning_companion(false) }}
{{ header('Lista de tareas', 'Decide y prioriza el trabajo del día.', 'bi-list-task') }}
{{ module_tabs([('Lista','/tasks-list','bi-list-task'),('Gantt','/tasks-gantt','bi-bar-chart-steps',True),('Calendario','/tasks-calendar','bi-calendar3'),('Flujo','/tasks-flow','bi-signpost-split',True),('Kanban','/tasks-kanban','bi-kanban'),('Planificación','/tasks-planning','bi-calendar-week'),('Progreso','/tasks-progress','bi-trophy',True),('Ajustes','/tasks-settings','bi-sliders',True)], '/tasks-list') }}
<p><a class="lt-link" href="#/tasks-categories">Categorías de Tareas</a></p>
<section class="lt-metrics">{{ metric('Pendientes','12','warning') }}{{ metric('En curso','4') }}{{ metric('Completadas','18','success') }}</section>
{% call(zone) manage_card('tasks', 'Tareas priorizadas', 'bi-list-task', count='(4 / 34)', total=34, search='Buscar tareas', menu=[('Exportar CSV', 'bi-filetype-csv'), ('Imprimir', 'bi-printer')], footer={'from':1,'to':4,'total':34,'noun':'tareas','page':1,'pages':2,'per_page':25}, sort=[('chronological','Cronológico','bi-calendar-event'),('priority','Prioridad','bi-exclamation-circle'),('recent','Más recientes','bi-clock-history'),('title','Título (A–Z)','bi-sort-alpha-down')]) %}{% if zone == 'filters' %}
      <div class="lt-popover" id="tasks-filters" role="dialog" aria-labelledby="tasks-filters-title" hidden><span class="lt-popover__handle" aria-hidden="true"></span>
        <div class="lt-popover__head"><h4 id="tasks-filters-title">Filtros</h4><button class="lt-icon-button" type="button" data-lt-toggle="tasks-filters" aria-label="Cerrar filtros"><i class="bi bi-x-lg"></i></button></div>
        <div class="lt-field"><span>Estado</span><div class="lt-chip-row"><button class="lt-chip lt-chip--filter is-selected" type="button" data-lt-static-nav aria-pressed="true">Todas</button><button class="lt-chip lt-chip--filter" type="button" data-lt-static-nav>Pendientes</button><button class="lt-chip lt-chip--filter" type="button" data-lt-static-nav>En curso</button><button class="lt-chip lt-chip--filter" type="button" data-lt-static-nav>Completadas</button></div></div>
        <div class="lt-field"><span id="tasks-category-label">Categoría</span><div class="lt-multiselect">
          <button class="lt-multiselect__trigger" type="button" data-lt-toggle="tasks-category-options" aria-haspopup="dialog" aria-expanded="false" aria-labelledby="tasks-category-label"><span>Todas las categorías</span><i class="bi bi-chevron-down" aria-hidden="true"></i></button>
          <div class="lt-multiselect__panel" id="tasks-category-options" role="dialog" aria-labelledby="tasks-category-label" hidden>
            <label class="lt-field"><span class="lt-sr-only">Buscar categorías</span><input type="search" placeholder="Buscar categorías"></label>
            {% for key,label in [('__none__','Sin categoría'),('personal','Personal'),('work','Trabajo'),('projects','Trabajo / Proyectos'),('finance','Finanzas')] %}<label class="lt-multiselect__option"><input type="checkbox" value="{{ key }}"> {{ label }}</label>{% endfor %}
          </div>
        </div></div>
        <label class="lt-field"><span>Prioridad</span><select><option>Todas</option><option>Alta</option><option>Media</option><option>Baja</option></select></label>
        <label class="lt-field"><span>Fecha</span><select><option selected>Hoy</option><option>Esta semana</option><option>Vencidas</option><option>Sin fecha</option></select></label>
        <div class="lt-popover__actions"><button class="lt-button lt-button--outlined" type="button" data-task-category-clear><i class="bi bi-eraser" aria-hidden="true"></i>Limpiar</button><button class="lt-button" type="button" data-lt-toggle="tasks-filters"><i class="bi bi-funnel-fill" aria-hidden="true"></i>Filtrar</button></div>
      </div>
    {% else %}
<div class="lt-list">{% for task, meta, done in [('Preparar propuesta','Alta prioridad · 10:00',false),('Revisar presupuesto','Finanzas · 14:00',false),('Planificar semana','Personal · 18:00',false),('Enviar seguimiento','Completada',true)] %}<div class="lt-list-item" data-task-category="{{ ['projects','finance','personal','__none__'][loop.index0] }}"><span class="lt-check{% if done %} is-done{% endif %}">{% if done %}✓{% endif %}</span><div class="lt-list-item__body"><strong>{{ task }}</strong><span>{{ meta }}</span></div>{% if not done %}<span class="lt-chip">Pendiente</span>{% endif %}</div>{% endfor %}</div>{% endif %}{% endcall %}
{{ fab('Agregar tarea', 'bi-plus-lg') }}
{% call dialog('guardian-sheet','Abra · Nv 12',close_only=true) %}<div class="lt-learning-sheet">{{ team_art() }}<p>Equipo de la semana · Concentración</p><p>Compañero ficticio para revisar la experiencia.</p></div>{% endcall %}
{% endcall %}
