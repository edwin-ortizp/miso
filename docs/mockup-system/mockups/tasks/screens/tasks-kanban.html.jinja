{% from '@project/components/life-shell.html.jinja' import shell, tabs as module_tabs, header, metric %}
{% call shell('tasks', 'Kanban', 'bi-kanban') %}
{{ module_tabs([('Lista','/tasks-list','bi-list-task'),('Gantt','/tasks-gantt','bi-bar-chart-steps',True),('Calendario','/tasks-calendar','bi-calendar3'),('Flujo','/tasks-flow','bi-signpost-split',True),('Kanban','/tasks-kanban','bi-kanban'),('Planificación','/tasks-planning','bi-calendar-week'),('Progreso','/tasks-progress','bi-trophy',True),('Ajustes','/tasks-settings','bi-sliders',True)], '/tasks-kanban') }}
<section class="lt-metrics">{{ metric('Pendientes','12','warning') }}{{ metric('En curso','4') }}{{ metric('Completadas','18','success') }}</section>
<section class="lt-kanban">{% for lane, tasks in [('Pendientes',[('Preparar propuesta','Alta · hoy'),('Revisar presupuesto','Media · mañana')]),('En curso',[('Planificar semana','Personal · 60 %'),('Actualizar portafolio','Trabajo · 40 %')]),('Completadas',[('Enviar seguimiento','Completada hoy'),('Organizar archivos','Completada ayer')]) ] %}<article class="lt-kanban__lane"><h3>{{ lane }} <span class="lt-chip">{{ tasks|length }}</span></h3>{% for task, meta in tasks %}<div class="lt-task-card"><strong>{{ task }}</strong><small>{{ meta }}</small></div>{% endfor %}</article>{% endfor %}</section>
{% endcall %}