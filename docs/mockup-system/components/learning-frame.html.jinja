{% from '@project/components/task-creation.html.jinja' import task_creation %}
{% from '@project/components/favorite-companion.html.jinja' import favorite_companion %}
{% from '@project/components/life-shell.html.jinja' import shell, tabs, manage_card, dialog, fab, row_split %}
{% from '@project/components/task-dialog.html.jinja' import task_dialog %}
{% from '@project/components/learning-companion.html.jinja' import learning_companion, team_art %}
{% set formation_types = ['Carrera universitaria','Especialización','Maestría','Doctorado','Curso','Ruta personal'] %}
{% set categories = ['Agilidad','Idiomas','Tecnología','Profesional','Personal'] %}
{% macro field(name,label,type='text',required=false) %}<label class="lt-field"><span>{{ label }}{% if required %} *{% endif %}</span><input name="{{ name }}" type="{{ type }}"{% if required %} required{% endif %}{% if type == 'text' %} maxlength="160"{% endif %}></label>{% endmacro %}
{% macro section(key,title,hidden=false) %}<section class="lt-dialog__section" data-section="{{ key }}"{% if hidden %} hidden{% endif %}><header class="lt-dialog__section-head"><h3>{{ title }}</h3></header><div class="lt-form">{{ caller() }}</div></section>{% endmacro %}
{% macro learning_frame(view) %}
{% set modules = {'list':('learning','Formación','bi-mortarboard'), 'detail':('learning','Formación','bi-mortarboard'), 'calendar':('tasks','Calendario','bi-calendar3'), 'tasks':('tasks','Tareas','bi-list-task'), 'goals':('goals','Objetivos','bi-flag'), 'habits':('habits','Hábitos','bi-check2-square'), 'focus':('pomodoro','Pomodoro','bi-stopwatch')} %}
{% set module,title,icon = modules[view] %}
{% call shell(module,title,icon) %}
<div class="lt-learning" data-learning-view="{{ view }}">
{{ favorite_companion() }}
{% if view in ['calendar','tasks'] %}{{ tabs([('Lista','/learning-tasks','bi-list-task'),('Calendario','/learning-calendar','bi-calendar3')],'/learning-' ~ view) }}{% endif %}
<div class="lt-learning-heading"><div><nav class="lt-learning-breadcrumbs" data-breadcrumbs aria-label="Ubicación" hidden></nav><h2 data-page-title>{{ title }}</h2><p data-page-description></p></div><div class="lt-learning-heading-actions"><button class="lt-icon-button" type="button" data-learning-action="edit-learning" data-detail-back hidden aria-label="Editar formación"><i class="bi bi-pencil" aria-hidden="true"></i></button><button class="lt-icon-button" type="button" data-learning-action="sheet" data-companion-help aria-label="Ayuda de tu compañero"><i class="bi bi-stars" aria-hidden="true"></i></button></div></div>
<div data-empty-guide hidden><div data-empty-companion>{{ learning_companion(shared_art=true) }}</div><div class="lt-learning-empty-guide"><h3>¿Qué quieres estudiar?</h3><p>Organiza tu carrera universitaria, un posgrado, un curso o una ruta por tu cuenta. Empieza con una formación; sus periodos y contenidos se agregan después.</p><p>Usa <strong>Agregar formación</strong> o abre su flecha para elegir qué vas a crear.</p></div></div>
<div class="lt-learning-detail-tabs lt-tabs" data-detail-tabs hidden role="group" aria-label="Secciones del contenido"></div>
{% call(zone) manage_card('learning-management',title,icon,search='Buscar en esta vista') %}
{% if zone == 'filters' %}<div class="lt-popover" id="learning-management-filters" role="dialog" aria-labelledby="learning-filter-title" hidden><h4 id="learning-filter-title">Filtros</h4><div class="lt-form"><label class="lt-field"><span>Tipo</span><select data-filter-type><option value="">Todos</option>{% for t in formation_types %}<option>{{ t }}</option>{% endfor %}</select></label><label class="lt-field"><span>Categoría</span><select data-filter-category><option value="">Todas</option>{% for c in categories %}<option>{{ c }}</option>{% endfor %}</select></label><label class="lt-field"><span>Estado</span><select data-filter-status><option value="">Todos</option><option>En curso</option><option>Pendiente</option><option>Completado</option></select></label></div><div class="lt-popover__actions"><button class="lt-button lt-button--text" type="button" data-learning-action="clear-filters">Limpiar</button><button class="lt-button" type="button" data-lt-toggle="learning-management-filters">Aplicar</button></div></div>
{% else %}<div data-learning-content></div>{% endif %}
{% endcall %}
<p class="lt-learning-feedback" role="status" data-learning-feedback></p>
<div data-learning-fab></div>
<template data-fab="list">{{ fab('Agregar formación','bi-plus-lg','learning-editor',actions=[('Carrera universitaria','bi-mortarboard','learning-editor'),('Especialización','bi-mortarboard','learning-editor'),('Maestría','bi-mortarboard','learning-editor'),('Doctorado','bi-mortarboard','learning-editor'),('Curso','bi-journal-bookmark','learning-editor'),('Ruta personal','bi-signpost-split','learning-editor')],split=true,id='lt-fab-list') }}</template>
{% for kind,primary,children,resources in [
 ('academic','Agregar periodo',[('Agregar materia','subject')],false),
 ('period','Agregar materia',[],false),
 ('course','Agregar módulo',[],true),
 ('personal','Agregar etapa',[('Agregar curso','course'),('Agregar tema','topic')],false),
 ('stage','Agregar curso',[('Agregar tema','topic')],true),
 ('subject','Agregar tema',[],true),
 ('module','Agregar tema',[],true),
 ('topic','Agregar tarea',[],true)] %}
{% set extra = [('Reservar tiempo de estudio','bi-calendar-plus','slot-editor')] %}
{% if resources %}{% set extra = extra + [('Agregar tarea','bi-list-task','task-dialog'),('Agregar material','bi-journal-text','material-editor'),('Agregar evaluación','bi-journal-check','grade-editor'),('Vincular tareas y hábitos','bi-link-45deg','association-editor')] %}{% endif %}
{% if children %}{% set extra = [(children[0][0],'bi-signpost-split','node-editor')] + ([(children[1][0],'bi-signpost-split','node-editor')] if children|length > 1 else []) + extra %}{% endif %}
<template data-fab="{{ kind }}">{{ fab(primary,'bi-plus-lg','task-dialog' if kind == 'topic' else 'node-editor',actions=extra,split=true,id='lt-fab-' ~ kind) }}</template>
{% endfor %}
<template data-fab="calendar">{{ fab('Reservar tiempo','bi-calendar-plus','slot-editor') }}</template>
<template data-fab="tasks">{{ fab('Crear tarea','bi-plus-lg','task-dialog',actions=[('Crear varias','bi-list-task','bulk-task-editor')],split=true,id='lt-task-create-menu') }}</template>
<template data-row-actions="learning">{{ row_split('formation-__ROW__','Consultar',[('Editar','bi-pencil',false,'learning-edit')],'__TITLE__',action='learning-open') }}</template>
<template data-row-actions="node">{{ row_split('unit-__ROW__','Consultar',[('Editar','bi-pencil',false,'node-edit'),('Subir','bi-arrow-up',false,'node-up'),('Bajar','bi-arrow-down',false,'node-down')],'__TITLE__',action='node-open') }}</template>
<template data-row-actions="task">{{ row_split('task-__ROW__','Consultar',[('Iniciar foco','bi-stopwatch',false,'focus-task')],'__TITLE__',action='task-open') }}</template>
<template data-row-actions="grade">{{ row_split('grade-__ROW__','Consultar',[('Editar','bi-pencil',false,'grade-edit')],'__TITLE__',action='grade-view') }}</template>
<template data-row-actions="slot">{{ row_split('slot-__ROW__','Consultar',[('Editar o cancelar','bi-pencil',false,'slot-open')],'__TITLE__',action='slot-open') }}</template>
<template data-row-actions="material">{{ row_split('material-__ROW__','Consultar',[('Editar','bi-pencil',false,'material-edit')],'__TITLE__',action='material-view') }}</template>
{% call dialog('learning-editor','Agregar formación',icon='bi-mortarboard',sections=[('basic','Información básica','bi-mortarboard'),('organization','Organización','bi-diagram-3'),('relations','Relaciones','bi-link-45deg')],submit_action='learning-save') %}
<form data-form="learning"><input type="hidden" name="id">
{% call section('basic','Información básica') %}
<label class="lt-field"><span>Tipo de formación *</span><select name="type" required><option value="">¿Qué vas a estudiar?</option>{% for t in formation_types %}<option>{{ t }}</option>{% endfor %}</select></label>
<label class="lt-field"><span data-formation-name>Nombre de la formación *</span><input name="title" required maxlength="160" placeholder="Por ejemplo, Ingeniería de Sistemas"></label>
<p class="lt-form--full" data-type-locked hidden>El tipo se conserva porque esta formación ya tiene contenido organizado.</p><label class="lt-field lt-form--full"><span>Descripción</span><textarea name="description" rows="3"></textarea></label>
{% endcall %}
{% call section('organization','Organización',true) %}
<label class="lt-field"><span>Categoría</span><select name="category"><option value="">Sin categoría</option>{% for c in categories %}<option>{{ c }}</option>{% endfor %}</select></label>
<label class="lt-field"><span>Estado</span><select name="status"><option>En curso</option><option>Pendiente</option><option>Completado</option></select></label>
{{ field('institution','Institución o plataforma') }}{{ field('start','Fecha de inicio','date') }}{{ field('end','Fecha final','date') }}
<p class="lt-form--full">La categoría sirve para agrupar formaciones. Los periodos y contenidos se agregan dentro de cada formación.</p>
{% endcall %}
{% call section('relations','Relaciones',true) %}<label class="lt-field lt-form--full"><span>Objetivo relacionado</span><select name="goal" data-goal-options></select></label><p>Vincula un objetivo existente para recordar para qué estudias.</p><fieldset class="lt-form--full"><legend>Hábitos que apoyan esta formación</legend><div data-habit-checkboxes></div></fieldset>{% endcall %}<p role="alert" data-form-error></p></form>
{% endcall %}
{% call dialog('node-editor','Agregar contenido',icon='bi-signpost-split',sections=[('basic','Información básica','bi-file-earmark-text'),('organization','Organización','bi-diagram-3')],submit_action='node-save') %}
<form data-form="node"><input type="hidden" name="id"><input type="hidden" name="learning"><input type="hidden" name="parent"><input type="hidden" name="kind">
{% call section('basic','Información básica') %}<p class="lt-form--full" data-node-location></p>{{ field('title','Nombre',required=true) }}<label class="lt-field"><span>Estado</span><select name="status"><option>Pendiente</option><option>En curso</option><option>Completado</option></select></label><label class="lt-field lt-form--full"><span>Descripción</span><textarea name="description" rows="3"></textarea></label>{% endcall %}
{% call section('organization','Organización',true) %}{{ field('start','Fecha de inicio','date') }}{{ field('end','Fecha final','date') }}<label class="lt-field" data-credits-field hidden><span>Créditos (opcional)</span><input name="credits" type="number" min="0" max="100" step="0.5"></label><p class="lt-form--full">Este contenido conserva la ubicación desde la que lo creas. Puedes ordenar los elementos desde sus acciones.</p>{% endcall %}<p role="alert" data-form-error></p></form>{% endcall %}
{% call dialog('grade-editor','Agregar evaluación',icon='bi-journal-check',sections=[('basic','Información básica','bi-journal-check'),('grading','Calificación','bi-percent')],submit_action='grade-save') %}<form data-form="grade"><input type="hidden" name="id"><input type="hidden" name="node">
{% call section('basic','Información básica') %}<p class="lt-form--full" data-grade-location></p>{{ field('title','Nombre de la evaluación',required=true) }}{{ field('date','Fecha','date') }}{% endcall %}
{% call section('grading','Calificación',true) %}<label class="lt-field"><span>Ponderación (%) *</span><input name="weight" type="number" min="0.01" max="100" step="0.01" value="30" required></label><label class="lt-field"><span>Mínimo de escala *</span><input name="min" type="number" step="0.01" value="0" required></label><label class="lt-field"><span>Máximo de escala *</span><input name="max" type="number" step="0.01" value="5" required></label><label class="lt-field"><span>Nota (vacía si está pendiente)</span><input name="score" type="number" step="0.01"></label><p class="lt-form--full">Una nota pendiente no es cero. El resultado solo será final con todas las notas y ponderaciones que sumen 100 %.</p>{% endcall %}<p role="alert" data-form-error></p></form>{% endcall %}
{% call dialog('slot-editor','Reservar tiempo de estudio',icon='bi-calendar-plus',sections=[('basic','Programación','bi-calendar3'),('repeat','Repetición','bi-arrow-repeat'),('relations','Tareas vinculadas','bi-link-45deg')],submit_action='slot-save') %}<form data-form="slot">
{% call section('basic','Programación') %}<p class="lt-form--full" data-slot-location></p><input type="hidden" name="id"><input type="hidden" name="occurrence"><input type="hidden" name="node"><label class="lt-field lt-form--full"><span>Título *</span><input name="title" required maxlength="160" value="Estudiar"></label><label class="lt-field"><span>Formación (opcional)</span><select name="learning" data-learning-options data-optional></select></label><label class="lt-field"><span>Fecha *</span><input name="date" type="date" required></label><label class="lt-field"><span>Desde *</span><input name="start" type="time" value="16:00" required></label><label class="lt-field"><span>Hasta *</span><input name="end" type="time" value="18:00" required></label>{% endcall %}
{% call section('repeat','Repetición',true) %}<label class="lt-field"><span>Repetir</span><select name="frequency"><option value="none">No repetir</option><option value="daily">Diariamente</option><option value="weekly">Semanalmente</option></select></label><label class="lt-field"><span>Cada (días o semanas)</span><input name="interval" type="number" min="1" max="52" value="1" required></label><fieldset class="lt-form--full lt-learning-weekdays"><legend>Días de la semana</legend>{% for value,label in [('1','Lu'),('2','Ma'),('3','Mi'),('4','Ju'),('5','Vi'),('6','Sá'),('0','Do')] %}<label><input type="checkbox" name="days" value="{{ value }}">{{ label }}</label>{% endfor %}</fieldset><label class="lt-field"><span>Hasta el día (opcional)</span><input name="until" type="date"></label><label class="lt-field"><span>Aplicar cambio a</span><select name="scope"><option value="one">Esta ocurrencia</option><option value="series">Toda la serie</option></select></label><p class="lt-form--full">Editar toda la serie reemplaza el patrón y restablece las excepciones. Mover una ocurrencia conserva las demás.</p>{% endcall %}
{% call section('relations','Tareas vinculadas',true) %}<fieldset class="lt-form--full"><legend>Tareas vinculadas (opcional)</legend><div data-task-checkboxes></div></fieldset>{% endcall %}<p role="alert" data-form-error></p></form><button class="lt-button lt-button--text" type="button" data-learning-action="slot-delete" hidden>Cancelar reserva según el alcance elegido</button>{% endcall %}
{% call dialog('association-editor','Vincular tareas y hábitos',icon='bi-link-45deg',sections=[('tasks','Tareas','bi-list-task'),('habits','Hábitos','bi-check2-square')],submit_action='association-save') %}<form data-form="association"><input type="hidden" name="node"><p data-association-location></p>{% call section('tasks','Tareas') %}<fieldset class="lt-form--full"><legend>Tareas existentes</legend><div data-task-checkboxes></div></fieldset>{% endcall %}{% call section('habits','Hábitos',true) %}<fieldset class="lt-form--full"><legend>Hábitos existentes</legend><div data-habit-checkboxes></div></fieldset>{% endcall %}<p role="alert" data-form-error></p></form>{% endcall %}
{% call dialog('material-editor','Agregar material',icon='bi-journal-text',sections=[('basic','Información básica','bi-journal-text'),('notes','Contenido','bi-file-earmark-text')],submit_action='material-save') %}<form data-form="material"><input type="hidden" name="id"><input type="hidden" name="node">{% call section('basic','Información básica') %}<p class="lt-form--full" data-material-location></p>{{ field('title','Nombre del material',required=true) }}<label class="lt-field"><span>Tipo de material</span><select name="type"><option>Apunte</option><option>Referencia</option><option>Recurso</option></select></label>{% endcall %}{% call section('notes','Contenido',true) %}<label class="lt-field lt-form--full"><span>Contenido o referencia</span><textarea name="content" rows="7"></textarea></label>{% endcall %}<p role="alert" data-form-error></p></form>{% endcall %}
{% call dialog('reference-view','Consulta',icon='bi-journal-text',close_only=true) %}<div data-reference-content></div>{% endcall %}
{% call dialog('guardian-sheet','Tu compañero',icon='bi-stars',close_only=true) %}<div class="lt-learning-sheet" data-sheet-art><span data-guardian-art></span><h3>Abra · Nv 12</h3><p>Equipo de la semana · Concentración</p></div><p data-context-advice></p>{% endcall %}
{{ task_dialog() }}
{% if view == 'tasks' %}{{ task_creation() }}{% endif %}
</div>{% endcall %}{% endmacro %}
