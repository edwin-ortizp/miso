{#- Grupos de módulos (config/modules.php): (etiqueta, ícono, [(módulo, ícono, id)]). Los usan el shell y el rail del panel de pared. -#}
{% set module_groups = [
('Vista general', 'bi-grid-1x2', [('Mi día','bi-sunrise','home'),('Estadísticas','bi-bar-chart','statistics'),('Ajustes','bi-gear','settings')]),
('Salud y cuerpo', 'bi-heart-pulse', [('Salud','bi-heart-pulse','health'),('Ejercicio','bi-activity','exercise'),('Hidratación','bi-droplet','hydration'),('Comidas','bi-egg-fried','meals')]),
('Hábitos', 'bi-check2-square', [('Hábitos','bi-check2-square','habits'),('Hábitos a evitar','bi-shield-check','negative-habits')]),
('Productividad', 'bi-calendar-check', [('Tareas','bi-list-task','tasks'),('Pomodoro','bi-stopwatch','pomodoro'),('Objetivos','bi-flag','goals')]),
('Vida personal', 'bi-person-heart', [('Diario','bi-journal-text','journal'),('Relaciones','bi-people','relationships'),('Planes','bi-map','plans'),('Ánimo y energía','bi-emoji-smile','mood')]),
('Vehículos', 'bi-car-front', [('Vehículos','bi-car-front','vehicles')])
] %}
{#- `back` = (ruta, etiqueta): en un detalle sin pestañas el regreso va en la barra superior, antes del ícono del módulo. -#}
{% macro shell(module, title, icon, catalog_navigation=None, status=None, back=None) -%}

<div class="lt-shell" data-module="{{ module }}">
  <aside class="lt-sidebar" aria-label="Módulos de Life Tracker">
    <div class="lt-sidebar__brand"><span class="lt-sidebar__mark" aria-hidden="true"><i class="bi bi-activity"></i></span><span class="lt-sidebar__name">Life Tracker</span></div>
    <nav class="lt-sidebar__scroll">
      {% if catalog_navigation %}<div class="lt-nav-group"><span class="lt-nav-group__label">Sistema visual</span>{% for nav_label, nav_icon, category in catalog_navigation %}<button class="lt-nav-item{% if loop.first %} is-active{% endif %}" type="button" data-catalog-category="{{ category }}"{% if loop.first %} aria-current="page"{% endif %}><span class="lt-nav-item__icon"><i class="bi {{ nav_icon }}" aria-hidden="true"></i></span><span class="lt-nav-item__label">{{ nav_label }}</span></button>{% endfor %}</div>{% else %}{% for label, group_icon, items in module_groups %}<div class="lt-nav-group"><span class="lt-nav-group__label">{{ label }}</span>{% for nav_label, nav_icon, nav_module in items %}<button class="lt-nav-item{% if nav_module == module %} is-active{% endif %}" type="button" data-module="{{ nav_module }}" data-lt-static-nav{% if nav_module == module %} aria-current="page"{% endif %}><span class="lt-nav-item__icon"><i class="bi {{ nav_icon }}" aria-hidden="true"></i></span><span class="lt-nav-item__label">{{ nav_label }}</span></button>{% endfor %}</div>{% endfor %}{% endif %}
    </nav>
  </aside>
  <button class="lt-scrim" type="button" data-lt-close-drawer aria-label="Cerrar módulos"></button>
  <div class="lt-shell__body">
    <header class="lt-topbar"><button class="lt-icon-button" type="button" data-lt-nav-toggle aria-label="Mostrar módulos"><i class="bi bi-list" aria-hidden="true"></i></button>{% if back %}<a class="lt-icon-button lt-topbar__back" href="#{{ back[0] }}" aria-label="{{ back[1] }}" title="{{ back[1] }}"><i class="bi bi-arrow-left" aria-hidden="true"></i></a>{% endif %}<span class="lt-topbar__icon" aria-hidden="true"><i class="bi {{ icon }}"></i></span><h1 class="lt-topbar__title">{{ title }}</h1>{% if status %}<span class="lt-chip lt-chip--success lt-topbar__status">{{ status }}</span>{% endif %}<div class="lt-search" role="search"><i class="bi bi-search" aria-hidden="true"></i><label class="lt-sr-only" for="lt-search-{{ module }}">Buscar en todos los módulos</label><input id="lt-search-{{ module }}" type="search" placeholder="Buscar en todos los módulos…" data-lt-search-input></div><button class="lt-icon-button lt-topbar__search-button" type="button" data-lt-search aria-label="Buscar"><i class="bi bi-search" aria-hidden="true"></i></button><div class="lt-topbar__tools"><button class="lt-icon-button" type="button" data-lt-static-nav aria-label="Ajustes"><i class="bi bi-gear" aria-hidden="true"></i></button><button class="lt-icon-button" type="button" data-lt-static-nav aria-label="Notificaciones"><i class="bi bi-bell" aria-hidden="true"></i></button><button class="lt-profile" type="button" data-lt-static-nav aria-label="Abrir menú de perfil" aria-haspopup="menu"><img src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 80 80'%3E%3Crect width='80' height='80' fill='%23C9B8A6'/%3E%3Ccircle cx='40' cy='32' r='15' fill='%23E8C4A2'/%3E%3Cpath d='M25 28c0-11 7-17 15-17s16 6 15 17c-3-5-8-7-15-7s-12 2-15 7z' fill='%233B2A20'/%3E%3Cpath d='M12 80c2-17 13-25 28-25s26 8 28 25z' fill='%23455A64'/%3E%3C/svg%3E" alt="" width="40" height="40"></button></div></header>
    <main class="lt-main"><div class="lt-page">{{ caller() }}</div></main>
    <nav class="lt-bottom" aria-label="Destinos principales"><button class="lt-bottom__item{% if module == 'home' %} is-active{% endif %}" type="button" data-lt-static-nav><i class="bi bi-house" aria-hidden="true"></i><span>Inicio</span></button><button class="lt-bottom__item{% if module == 'habits' %} is-active{% endif %}" type="button" data-lt-static-nav><i class="bi bi-check2-square" aria-hidden="true"></i><span>Hábitos</span></button><button class="lt-bottom__item{% if module == 'tasks' %} is-active{% endif %}" type="button" data-lt-static-nav><i class="bi bi-list-task" aria-hidden="true"></i><span>Tareas</span></button><button class="lt-bottom__item" type="button" data-lt-static-nav><i class="bi bi-bar-chart" aria-hidden="true"></i><span>Stats</span></button><button class="lt-bottom__item" type="button" data-lt-open-drawer><i class="bi bi-grid" aria-hidden="true"></i><span>Módulos</span></button></nav>
  </div>
</div>
{%- endmacro %}

{% macro tabs(items, current) -%}
<nav class="lt-tabs" aria-label="Vistas del módulo">{% for item in items %}{% set label, route, icon = item[0], item[1], item[2] %}{% if item|length > 3 and item[3] %}<button class="lt-tab" type="button" data-lt-static-nav><i class="bi {{ icon }}" aria-hidden="true"></i><span>{{ label }}</span></button>{% else %}<a class="lt-tab{% if route == current %} is-active{% endif %}" href="#{{ route }}"{% if route == current %} aria-current="page"{% endif %}><i class="bi {{ icon }}" aria-hidden="true"></i><span>{{ label }}</span></a>{% endif %}{% endfor %}</nav>
{%- endmacro %}

{#- Navegación de detalle (pilar transversal): el ← vive al inicio de la fila de pestañas, seguido de un divisor.
    Nunca se agrega una fila solo para «Volver». Un detalle sin pestañas usa shell(back=…). -#}
{% macro detail_nav(items, current, back_route, back_label) -%}
<div class="lt-detail-nav"><a class="lt-icon-button lt-detail-nav__back" href="#{{ back_route }}" aria-label="{{ back_label }}" title="{{ back_label }}"><i class="bi bi-arrow-left" aria-hidden="true"></i></a><span class="lt-detail-nav__divider" aria-hidden="true"></span>{{ tabs(items, current) }}</div>
{%- endmacro %}

{% macro relationship_tabs(current) -%}
{{ detail_nav([('Inicio','/relationships-show','bi-house'),('Planes','/relationships-plans','bi-map'),('Historial','/relationships-history','bi-clock-history'),('Tareas relacionadas',None,'bi-list-check',true)], current, '/relationships-index', 'Volver a Relaciones') }}
{%- endmacro %}

{#- Card resumida de gestión: mismo header que `manage_card` (ícono, título) con una acción de texto «Ver…», sin búsqueda, filtros ni paginación. -#}
{% macro summary_card(id, title, icon, link_label=None, link_route=None) -%}
<article class="lt-mcard lt-mcard--summary" id="{{ id }}" aria-labelledby="{{ id }}-title">
  <header class="lt-mcard__head"><div class="lt-mcard__title"><span class="lt-mcard__icon" aria-hidden="true"><i class="bi {{ icon }}"></i></span><h3 id="{{ id }}-title"><span class="lt-mcard__heading-text">{{ title }}</span></h3></div>{% if link_label %}{% if link_route %}<a class="lt-button lt-button--text lt-mcard__link" href="#{{ link_route }}">{{ link_label }}</a>{% else %}<button class="lt-button lt-button--text lt-mcard__link" type="button" data-lt-static-nav>{{ link_label }}</button>{% endif %}{% endif %}</header>
  <div class="lt-mcard__body">{{ caller() }}</div>
</article>
{%- endmacro %}

{% macro vehicle_tabs(current) -%}
{{ detail_nav([('Resumen','/vehicles-show','bi-speedometer2'),('Combustible','/vehicles-fuel','bi-fuel-pump'),('Plan de mantenimiento','/vehicles-maintenance','bi-calendar2-check'),('Historial de mantenimiento','/vehicles-maintenance-history','bi-clock-history'),('Gastos','/vehicles-expenses','bi-wallet2')], current, '/vehicles-index', 'Volver al garaje') }}
{%- endmacro %}

{#- Sin encabezado dentro del contenido: la identidad vive en la barra superior y el regreso usa detail_nav o shell(back=…). -#}
{% macro header(title, subtitle, icon, back=None) -%}{%- endmacro %}

{% macro metric(label, value, tone='primary') -%}<article class="lt-metric lt-metric--{{ tone }}"><span>{{ label }}</span><strong>{{ value }}</strong></article>{%- endmacro %}

{#- `close_only`: diálogo de solo lectura, con un único botón «Cerrar» sin ícono. -#}
{% macro dialog(id, title, submit='Guardar', icon=None, sections=None, submit_action=None, close_only=False) -%}
<div class="lt-dialog-layer" id="{{ id }}" hidden>
  <button class="lt-dialog-scrim" type="button" data-lt-toggle="{{ id }}" aria-label="Cerrar" tabindex="-1"></button>
  <section class="lt-dialog{% if sections %} lt-dialog--sections{% endif %}" role="dialog" aria-modal="true" aria-labelledby="{{ id }}-title">
    <header class="lt-dialog__head">
      {% if sections %}<button class="lt-icon-button" type="button" data-lt-dialog-sidebar aria-controls="{{ id }}-nav" aria-expanded="true" aria-label="Mostrar u ocultar secciones"><i class="bi bi-layout-sidebar"></i></button>{% endif %}
      {% if icon %}<span class="lt-dialog__icon"><i class="bi {{ icon }}" aria-hidden="true"></i></span>{% endif %}
      <h2 id="{{ id }}-title">{{ title }}</h2>
      <button class="lt-icon-button" type="button" data-lt-dialog-expand aria-pressed="false" aria-label="Expandir"><i class="bi bi-arrows-fullscreen"></i></button>
      <button class="lt-icon-button" type="button" data-lt-toggle="{{ id }}" aria-label="Cerrar"><i class="bi bi-x-lg"></i></button>
    </header>
    <div class="lt-dialog__main">
      {% if sections %}<nav class="lt-dialog__nav" id="{{ id }}-nav" aria-label="Secciones del formulario">{% for key, label, sicon in sections %}<button class="lt-dialog__nav-item" type="button" data-lt-dialog-section="{{ key }}"{% if loop.first %} aria-current="true"{% endif %}><i class="bi {{ sicon }}" aria-hidden="true"></i><span>{{ label }}</span></button>{% endfor %}</nav>{% endif %}
      <div class="lt-dialog__body">{{ caller() }}</div>
    </div>
    <footer class="lt-dialog__actions">{% if close_only %}<button class="lt-button" type="button" data-lt-toggle="{{ id }}">Cerrar</button>{% else %}<button class="lt-button lt-button--text" type="button" data-lt-toggle="{{ id }}">Cancelar</button><button class="lt-button" type="button"{% if submit_action %} data-lt-action="{{ submit_action }}"{% else %} data-lt-toggle="{{ id }}"{% endif %}><i class="bi bi-floppy"></i> {{ submit }}</button>{% endif %}</footer>
  </section>
</div>
{%- endmacro %}

{#- FAB canónico de creación: extendido en escritorio, solo ícono en móvil.
    `target` es el id del diálogo que abre; `actions` = [(label, icon, target), ...] despliega un menú FAB. -#}
{#- Con `split=True` el FAB es dividido (M3 split button): el segmento principal ejecuta la acción y el chevron despliega `actions`. -#}
{% macro fab(label, icon='bi-plus-lg', target=None, actions=None, id='lt-fab-menu', split=False) -%}
{% if actions and split %}<div class="lt-fab-dial lt-fab-split">
  <div class="lt-fab-dial__menu" id="{{ id }}" role="menu" hidden><button class="lt-fab-dial__item lt-fab-dial__item--primary" type="button" role="menuitem"{% if target %} data-lt-toggle="{{ target }}" aria-haspopup="dialog"{% else %} data-lt-static-nav{% endif %}><span>{{ label }}</span><i class="bi {{ icon }}" aria-hidden="true"></i></button>{% for alabel, aicon, atarget in actions %}<button class="lt-fab-dial__item" type="button" role="menuitem"{% if atarget %} data-lt-toggle="{{ atarget }}" aria-haspopup="dialog"{% else %} data-lt-static-nav{% endif %}><span>{{ alabel }}</span><i class="bi {{ aicon }}" aria-hidden="true"></i></button>{% endfor %}</div>
  <div class="lt-fab-split__group"><button class="lt-fab lt-fab-split__main" type="button"{% if target %} data-lt-toggle="{{ target }}" aria-haspopup="dialog"{% else %} data-lt-static-nav{% endif %} aria-label="{{ label }}"><i class="bi {{ icon }}" aria-hidden="true"></i><span>{{ label }}</span></button><button class="lt-fab lt-fab-split__toggle" type="button" data-lt-toggle="{{ id }}" aria-haspopup="menu" aria-expanded="false" aria-label="Más acciones de creación"><i class="bi bi-chevron-up" aria-hidden="true"></i></button></div>
  <button class="lt-fab lt-fab-split__compact" type="button" data-lt-toggle="{{ id }}" aria-haspopup="menu" aria-expanded="false" aria-label="{{ label }}"><i class="bi {{ icon }}" aria-hidden="true"></i><span>{{ label }}</span></button>
</div>{% elif actions %}<div class="lt-fab-dial">
  <div class="lt-fab-dial__menu" id="{{ id }}" role="menu" hidden>{% for alabel, aicon, atarget in [(label, icon, target)] + actions %}<button class="lt-fab-dial__item" type="button" role="menuitem"{% if atarget %} data-lt-toggle="{{ atarget }}" aria-haspopup="dialog"{% else %} data-lt-static-nav{% endif %}><span>{{ alabel }}</span><i class="bi {{ aicon }}" aria-hidden="true"></i></button>{% endfor %}</div>
  <button class="lt-fab" type="button" data-lt-toggle="{{ id }}" aria-haspopup="menu" aria-expanded="false" aria-label="{{ label }}"><i class="bi {{ icon }}" aria-hidden="true"></i><span>{{ label }}</span></button>
</div>{% else %}<button class="lt-fab" type="button"{% if target %} data-lt-toggle="{{ target }}" aria-haspopup="dialog"{% else %} data-lt-static-nav{% endif %} aria-label="{{ label }}"><i class="bi {{ icon }}" aria-hidden="true"></i><span>{{ label }}</span></button>{% endif %}
{%- endmacro %}

{#- Card de gestión estándar: header (ícono, título, contador | buscador, filtros | ⋮), contenido y footer con paginación.
    `caller(zone)` recibe 'filters' (popover de filtros) y 'content' (chips aplicados + listado).
    `menu` = [(label, icon[, dialog_id]), ...]; `footer` = {from, to, total, noun, page, pages, per_page}. -#}
{% macro manage_card(id, title, icon, count=None, search='Buscar', filters=0, menu=None, footer=None, total=None, sort=None, footer_all=None) -%}
<article class="lt-mcard" id="{{ id }}" aria-labelledby="{{ id }}-title">
  <header class="lt-mcard__head">
    <div class="lt-mcard__title"><span class="lt-mcard__icon" aria-hidden="true"><i class="bi {{ icon }}"></i></span><h3 id="{{ id }}-title"><span class="lt-mcard__heading-text">{{ title }}</span>{% if count %}<span class="lt-count" title="Registros visibles de los existentes"><span aria-hidden="true">·</span> <span data-lt-visible-count data-total="{{ total or '' }}">{{ count }}</span></span>{% endif %}</h3></div>
    <span class="lt-mcard__divider" aria-hidden="true"></span>
    <div class="lt-mcard__tools lt-filter-anchor">
      <label class="lt-mcard__search"><i class="bi bi-search" aria-hidden="true"></i><span class="lt-sr-only">{{ search }}</span><input type="search" placeholder="{{ search }}"><button class="lt-icon-button lt-mcard__search-close" type="button" data-lt-mcard-search aria-label="Cerrar búsqueda"><i class="bi bi-x-lg"></i></button></label>
      <button class="lt-icon-button lt-mcard__search-toggle" type="button" data-lt-mcard-search aria-expanded="false" aria-label="{{ search }}"><i class="bi bi-search"></i></button>
      {% if sort %}<div class="lt-menu-anchor lt-mcard__sort"><button class="lt-button lt-button--text lt-filter-button lt-sort-button" type="button" data-lt-toggle="{{ id }}-sort" aria-haspopup="menu" aria-expanded="false" aria-label="Ordenar por {{ sort[0][1] }}"><i class="bi bi-sort-down"></i><span class="lt-filter-button__label" data-lt-sort-label>{{ sort[0][1] }}</span></button>
        <div class="lt-menu lt-menu--down" id="{{ id }}-sort" role="menu" hidden>{% for key, label, sicon in sort %}<button class="lt-menu__item" role="menuitem" type="button" data-lt-sort="{{ key }}"{% if loop.first %} aria-checked="true"{% endif %}><i class="bi {{ sicon }}"></i> {{ label }}</button>{% endfor %}</div>
      </div>{% endif %}
      <button class="lt-button lt-button--text lt-filter-button" type="button" data-lt-toggle="{{ id }}-filters" aria-haspopup="dialog" aria-expanded="false" aria-controls="{{ id }}-filters" aria-label="Filtros"><i class="bi bi-sliders"></i><span class="lt-filter-button__label">Filtros</span><span class="lt-badge lt-badge--corner" data-lt-filter-count aria-label="{{ filters }} filtros activos"{% if not filters %} hidden{% endif %}>{{ filters }}</span></button>
      {{ caller('filters') }}
      <span class="lt-mcard__divider" aria-hidden="true"></span>
      <div class="lt-menu-anchor"><button class="lt-icon-button" type="button" data-lt-toggle="{{ id }}-menu" aria-haspopup="menu" aria-expanded="false" aria-label="Más acciones de {{ title }}"><i class="bi bi-three-dots-vertical"></i></button>
        <div class="lt-menu lt-menu--down" id="{{ id }}-menu" role="menu" hidden><button class="lt-menu__item" role="menuitem" type="button" data-lt-toggle="{{ id }}-menu"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Actualizar tabla</button>{% if menu %}<hr class="lt-menu__divider">{% endif %}{% for m in menu or [] %}<button class="lt-menu__item" role="menuitem" type="button"{% if m|length > 2 and m[2] %} data-lt-toggle="{{ m[2] }}" aria-haspopup="dialog"{% else %} data-lt-static-nav{% endif %}><i class="bi {{ m[1] }}"></i> {{ m[0] }}</button>{% endfor %}</div>
      </div>
    </div>
  </header>
  <div class="lt-mcard__body">{{ caller('content') }}</div>
  {% if footer %}{% set f = footer %}<footer class="lt-mcard__foot"{% if footer_all %} data-range-all="{{ ('Mostrando <strong>1–' ~ footer_all.to ~ '</strong> de <strong>' ~ footer_all.total ~ '</strong> ' ~ f.noun)|e }}" data-pages-all="{{ footer_all.pages }}"{% endif %}>
    <p class="lt-mcard__range">Mostrando <strong>{{ f.from }}–{{ f.to }}</strong> de <strong>{{ f.total }}</strong> {{ f.noun }}</p>
    <label class="lt-mcard__rows"><span>Filas por página</span><select>{% for n in [10, 25, 50, 100] %}<option{% if n == f.per_page %} selected{% endif %}>{{ n }}</option>{% endfor %}</select></label>
    <nav class="lt-pager" aria-label="Paginación de {{ title }}">
      <button class="lt-pager__step" type="button" data-lt-static-nav aria-label="Página anterior"{% if f.page == 1 %} disabled{% endif %}><i class="bi bi-chevron-left"></i><span>Anterior</span></button>
      {% for p in range(1, f.pages + 1) %}<button class="lt-pager__page{% if p == f.page %} is-active{% endif %}" type="button"{% if p == f.page %} aria-current="page"{% else %} data-lt-static-nav{% endif %} aria-label="Página {{ p }}">{{ p }}</button>{% endfor %}{% if footer_all %}{% for p in range(f.pages + 1, footer_all.pages + 1) %}<button class="lt-pager__page" type="button" data-lt-static-nav data-lt-outside-filter aria-label="Página {{ p }}">{{ p }}</button>{% endfor %}{% endif %}
      <span class="lt-pager__compact">{{ f.page }} / {{ f.pages }}</span>
      <button class="lt-pager__step" type="button" data-lt-static-nav aria-label="Página siguiente"{% if f.page == f.pages %} disabled{% endif %}><span>Siguiente</span><i class="bi bi-chevron-right"></i></button>
    </nav>
  </footer>{% endif %}
</article>
{%- endmacro %}

{# Acción por fila en vistas de gestión: split outline (principal + chevron con menú); en compacto, ⋮ con todas las acciones.
   `actions` = [(label, icon, danger, action, dialog), ...]; `dialog` abre un diálogo con data-lt-toggle. #}
{% macro row_split(id, label, actions, aria, action=None, dialog=None) -%}
<div class="lt-menu-anchor lt-row-split">
  <div class="lt-split">
    <button class="lt-button lt-split__main" type="button"{% if action %} data-lt-action="{{ action }}"{% elif dialog %} data-lt-toggle="{{ dialog }}" aria-haspopup="dialog"{% else %} data-lt-static-nav{% endif %}>{{ label }}</button>
    <button class="lt-button lt-split__toggle" type="button" data-lt-toggle="{{ id }}" aria-haspopup="menu" aria-expanded="false" aria-label="Más acciones de {{ aria }}"><i class="bi bi-chevron-down"></i></button>
  </div>
  <button class="lt-icon-button lt-row-more" type="button" data-lt-toggle="{{ id }}" aria-haspopup="menu" aria-expanded="false" aria-label="Acciones de {{ aria }}"><i class="bi bi-three-dots-vertical"></i></button>
  <div class="lt-menu lt-menu--down" id="{{ id }}" role="menu" hidden>
    <button class="lt-menu__item lt-row-more__edit" role="menuitem" type="button"{% if action %} data-lt-action="{{ action }}"{% elif dialog %} data-lt-toggle="{{ dialog }}" aria-haspopup="dialog"{% else %} data-lt-static-nav{% endif %}>{{ label }}</button>
    {% for a in actions %}{% if a|length > 2 and a[2] %}<hr class="lt-menu__divider">{% endif %}<button class="lt-menu__item{% if a|length > 2 and a[2] %} lt-menu__item--danger{% endif %}" role="menuitem" type="button"{% if a|length > 3 and a[3] %} data-lt-action="{{ a[3] }}"{% elif a|length > 4 and a[4] %} data-lt-toggle="{{ a[4] }}" aria-haspopup="dialog"{% else %} data-lt-static-nav{% endif %}><i class="bi {{ a[1] }}"></i> {{ a[0] }}</button>{% endfor %}
  </div>
</div>
{%- endmacro %}

{#- Filtros aplicados de una tarjeta de gestión: `chips` = [(icon, label), ...]; incluye «Limpiar filtros». -#}
{% macro applied_filters(chips) -%}
<div class="lt-chip-row lt-applied-filters" aria-label="Filtros aplicados">{% for icon, label in chips %}<span class="lt-chip lt-chip--input"><i class="bi {{ icon }}"></i> <span>{{ label }}</span><button class="lt-chip__remove" type="button" data-lt-remove-filter aria-label="Quitar filtro {{ label }}"><i class="bi bi-x"></i></button></span>{% endfor %}<button class="lt-link" type="button" data-lt-clear-filters>Limpiar filtros</button></div>
{%- endmacro %}

{#- Popover de filtros estándar con campo Fecha (por defecto «Hoy»); `caller()` añade campos propios. -#}
{% macro date_filters(id) -%}
<div class="lt-popover" id="{{ id }}-filters" role="dialog" aria-labelledby="{{ id }}-filters-title" hidden><span class="lt-popover__handle" aria-hidden="true"></span>
  <div class="lt-popover__head"><h4 id="{{ id }}-filters-title">Filtros</h4><button class="lt-icon-button" type="button" data-lt-toggle="{{ id }}-filters" aria-label="Cerrar filtros"><i class="bi bi-x-lg"></i></button></div>
  <label class="lt-field"><span>Fecha</span><select>{% for r in ['Hoy','Ayer','Últimos 7 días','Este mes','Todas las fechas'] %}<option{% if loop.first %} selected{% endif %}>{{ r }}</option>{% endfor %}</select></label>
  {{ caller() }}
  <div class="lt-popover__actions"><button class="lt-button lt-button--outlined" type="button" data-lt-clear-filters><i class="bi bi-eraser" aria-hidden="true"></i>Limpiar</button><button class="lt-button" type="button" data-lt-toggle="{{ id }}-filters"><i class="bi bi-funnel-fill" aria-hidden="true"></i>Filtrar</button></div>
</div>
{%- endmacro %}


{#- Calendario de una meta diaria: cada día es un recipiente que se llena desde abajo según su cumplimiento.
    `days` = [(valor, meta), ...] desde el día 1 (valor None = sin registros); `lead` = celdas vacías antes del día 1;
    `today` = número del día actual; `unit` = 'L' (valor en ml) o 'min'. -#}
{% macro goal_value(value, unit) -%}{% if unit == 'L' %}{{ '%.1f'|format(value / 1000)|replace('.', ',') }} L{% else %}{{ value }} min{% endif %}{%- endmacro %}
{% macro goal_calendar(label, lead, days_in_month, days, today, unit, streak_text) -%}
<div class="lt-goal-cal" role="grid" aria-label="{{ label }}">
  {% for dow in ['Lun','Mar','Mié','Jue','Vie','Sáb','Dom'] %}<span class="lt-goal-cal__dow" aria-hidden="true">{{ dow }}</span>{% endfor %}
  {% for _ in range(lead) %}<span class="lt-goal-day lt-goal-day--pad" aria-hidden="true"></span>{% endfor %}
  {% for d in range(1, days_in_month + 1) %}
    {% set rec = days[d - 1] if d <= days|length else None %}
    {% if rec and rec[0] is not none %}
      {% set pct = (rec[0] * 100 / rec[1])|round|int %}
      {% set text = goal_value(rec[0], unit) ~ ' de ' ~ goal_value(rec[1], unit) ~ ' (' ~ pct ~ ' %)' %}
      <div class="lt-goal-day{% if d == today %} is-today{% endif %}{% if pct >= 60 %} is-high{% endif %}" role="gridcell" style="--fill:{{ [pct, 100]|min }}%" title="{{ d }} sep: {{ text }}" aria-label="{{ d }} sep{% if d == today %}, hoy{% endif %}: {{ text }}"><span>{{ d }}</span></div>
    {% else %}
      <div class="lt-goal-day is-empty{% if d == today %} is-today{% endif %}" role="gridcell" title="{{ d }} sep: sin registros" aria-label="{{ d }} sep: sin registros"><span>{{ d }}</span></div>
    {% endif %}
  {% endfor %}
  {% for _ in range((7 - (lead + days_in_month) % 7) % 7) %}<span class="lt-goal-day lt-goal-day--pad" aria-hidden="true"></span>{% endfor %}
</div>
<hr class="lt-divider">
<p class="lt-goal-streak"><span aria-hidden="true">🔥</span> {{ streak_text }}</p>
{%- endmacro %}

{% macro meals_tabs(current) -%}
{{ tabs([('Planificación','/meals-weekly','bi-calendar-week'),('Recetas','/meals-recipes','bi-book'),('Qué cocinar','/meals-cook','bi-egg-fried'),('Ingredientes','/meals-ingredients','bi-basket'),('Compras','/meals-shopping','bi-cart3'),('Historial de compras','/meals-history','bi-clock-history'),('Ajustes','/meals-settings','bi-gear')], current) }}
{%- endmacro %}
